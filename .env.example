# ERP (Page Creation / Page Editing). Server-only: never exposed to the browser.
# ERP public API base URL, e.g. https://apierp.clickmasters.pk
CMS_API_URL=
# This website's domain exactly as registered (and active) in the ERP.
CMS_SITE_DOMAIN=clickmastersdigitalmarketing.com

# Shared secret for POST /api/erp-revalidate (the ERP calls it on publish so
# changes show on the next page load). Set the SAME long random value as
# ERP_REVALIDATE_SECRET in the ERP backend. Never commit the real value.
ERP_REVALIDATE_SECRET=

# ERP dashboard origins allowed to show /erp-preview (live editor preview) in
# an iframe, comma-separated. Must be set at build time (next.config.js
# headers). Defaults to https://erp.clickmasters.pk when empty.
ERP_ADMIN_ORIGINS=https://erp.clickmasters.pk,http://192.168.88.38:3000
